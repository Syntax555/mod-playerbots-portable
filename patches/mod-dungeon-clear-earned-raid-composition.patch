+namespace DcEarnedRecruitment
+{
+    bool Eligible(Player* player, uint8 expansion, uint8 minLevel, uint8 maxLevel, Player* leader)
+    {
+        Route const route{0, 0, 0, 0, 0, TEAM_NEUTRAL, expansion, minLevel, maxLevel};
+        return ::Eligible(player, route, leader);
+    }
+
+    bool Owned(Player* player, Player* leader)
+    {
+        return ::Owned(player, leader);
+    }
+
+    bool Invite(Player* leader, Player* member, char const* source)
+    {
+        if (!::Owned(leader, nullptr) || !::Owned(member, nullptr) || member->GetGroup() || member->GetGroupInvite())
+            return false;
+        WorldPacket invite;
+        invite << member->GetName() << uint32(0);
+        leader->GetSession()->HandleGroupInviteOpcode(invite);
+        return member->GetGroupInvite() && member->GetGroupInvite()->GetLeaderGUID() == leader->GetGUID() &&
+               GET_PLAYERBOT_AI(member)->DoSpecificAction("accept invitation", Event(source), true);
+    }
+
