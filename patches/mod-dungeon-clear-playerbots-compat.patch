 // --- RAID pre-boss muster (Plan C; see DcRaidMusterDecision.h) -----------
 
+template <typename AI>
+constexpr bool HasForceRebuff = requires(AI* ai)
+{
+    ai->forceRebuff.Begin(false);
+    ai->forceRebuff.End();
+    ai->forceRebuff.IsPending();
+};
+
+template <typename AI>
+void BeginRebuffWindow(AI* ai)
+{
+    if constexpr (HasForceRebuff<AI>)
+    {
+        if (!ai->HasStrategy("force rebuff", BOT_STATE_NON_COMBAT))
+            ai->ChangeStrategy("+force rebuff", BOT_STATE_NON_COMBAT);
+        ai->forceRebuff.Begin(false);
+    }
+    else if (!ai->HasStrategy("buff", BOT_STATE_NON_COMBAT))
+        ai->ChangeStrategy("+buff", BOT_STATE_NON_COMBAT);
+}
+
+template <typename AI>
+void EndRebuffWindow(AI* ai)
+{
+    if constexpr (HasForceRebuff<AI>)
+        ai->forceRebuff.End();
+}
+
+template <typename AI>
+bool IsRebuffPending(AI* ai)
+{
+    if constexpr (HasForceRebuff<AI>)
+        return ai->forceRebuff.IsPending();
+    else
+        // Legacy buffing exposes no completion state. Give normal spellcasts
+        // the bounded muster window; never fabricate buffs or reagents.
+        return true;
+}
+
+template <typename AI>
+uint32 MusterTimeoutMs(AI* /*ai*/, Player* bot, char const* key)
+{
+    uint32 seconds = DcSettings::GetUInt(bot, key);
+    if constexpr (!HasForceRebuff<AI>)
+    {
+        // Config values, unlike client overrides, are not clamped upstream.
+        // The legacy completion fallback requires finite, nonzero budgets.
+        if (DcSettingDef const* setting = FindDcSetting(key))
+        {
+            if (!seconds)
+                seconds = static_cast<uint32>(setting->defVal);
+            seconds = std::clamp(seconds, static_cast<uint32>(setting->minVal),
+                                static_cast<uint32>(setting->maxVal));
+        }
+    }
+    return seconds * 1000;
+}
+
