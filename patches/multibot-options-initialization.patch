+  local function initializePanel(self)
+    local AceGUI = getAceGUI()
+    local created = {}
+    local function useLegacy(reason)
+      pcall(debugCall, "OptionsPath", "legacy", reason)
+      local released = {}
+      local function markTree(widget)
+        if not widget or released[widget] then return end
+        released[widget] = true
+        for _, child in ipairs(widget.children or {}) do markTree(child) end
+      end
+      local function release(widget)
+        if not widget or released[widget] then return end
+        markTree(widget)
+        pcall(AceGUI.Release, AceGUI, widget)
+      end
+      if AceGUI then
+        release(self._aceRoot)
+        for widget in pairs(created) do release(widget) end
+      end
+      self._aceRoot = nil
+      for widget in pairs(created) do created[widget] = nil end
+
+      local ok, err = pcall(buildLegacyOptionsContent, self)
+      self._initialized = ok
+      if not ok then
+        if self._legacyScrollFrame then self._legacyScrollFrame:Hide() end
+        self._legacyInitialized = nil
+        if geterrorhandler then pcall(function() geterrorhandler()(err) end) end
+      end
+    end
+
+    if not AceGUI then
+      pcall(debugCall, "AceGUILoadState", "LibStub returned nil for AceGUI-3.0")
+      useLegacy("LibStub('AceGUI-3.0') not available")
+    else
+      local ok, err = pcall(function()
+        local probe = AceGUI:Create("Label")
+        assert(probe, "AceGUI Label widget unavailable")
+        created[probe] = true
+        AceGUI:Release(probe)
+        created[probe] = nil
+        buildAceContent(self, AceGUI, created, useLegacy)
+      end)
+      if not ok then useLegacy(err) end
+      self._initialized = self._aceRoot ~= nil or self._legacyInitialized == true
+    end
+  end
+
+  panel:SetScript("OnShow", function(self)
+    if self._initialized or self._initializing then return end
+    self._initializing = true
+    local ok, err = pcall(initializePanel, self)
+    self._initializing = nil
+    if not ok then
+      self._initialized = nil
+      if geterrorhandler then pcall(function() geterrorhandler()(err) end) end
+    end
   end)
 
