+-- Core updates newer than zone_netherstorm.sql reach existing realms after it.
+-- Restore what a fresh installation keeps where the realm still has the core rows.
+DELETE FROM `creature` WHERE `guid` BETWEEN 52066 AND 52070 AND `id` = 18855 AND `map` = 530;
+
+UPDATE `creature_addon` SET `bytes2` = 0, `auras` = ''
+WHERE `guid` = 70141 AND `path_id` = 701410 AND `mount` = 0 AND `bytes1` = 0 AND `bytes2` = 1
+  AND `emote` = 0 AND `visibilityDistanceType` = 0 AND `auras` IS NULL;
+
+UPDATE `creature_formations` SET `groupAI` = 515
+WHERE `leaderGUID` = 70141 AND `memberGUID` = 70141 AND `dist` = 0 AND `angle` = 0
+  AND `groupAI` = 3 AND `point_1` = 0 AND `point_2` = 0;
+UPDATE `creature_formations` SET `dist` = 4, `angle` = 225
+WHERE `leaderGUID` = 70141 AND `memberGUID` = 70089 AND `dist` = 3 AND `angle` = 180
+  AND `groupAI` = 515 AND `point_1` = 0 AND `point_2` = 0;
+
+-- Drijya's core script starts a waypoint path whose actions belong to the module's lists.
+-- The sums identify the unchanged core rows, so a customized script stays.
