+    SELECT COUNT(*) = 22 AND SUM(`id` = 2 AND `event_type` = 19 AND `event_param1` = 10310
+      AND `action_type` = 53 AND `action_param2` = 20281) = 1
+      AND SUM(`event_type`) = 1052 AND SUM(`event_param1`) = 10398 AND SUM(`action_type`) = 726
+      AND SUM(`action_param1`) = 4203637 AND SUM(`target_type`) = 64 AS `core`
+    FROM `smart_scripts` WHERE `entryorguid` = 20281 AND `source_type` = 0) AS `previous`) = 1;
