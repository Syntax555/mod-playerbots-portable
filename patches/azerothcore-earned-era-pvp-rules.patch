+{
+    // Resolve the earned match era before any player enters or score is earned.
+    if (!GetInstanceID() || GetStatus() != STATUS_WAIT_JOIN || GetStartTime() || GetPlayersSize() || !maxScore ||
+        maxScore > 0x7FFFFFFF)
+        return;
+
+    _configurableMaxTeamScore = maxScore;
+}
