index 34d4d74..1e8cc5c 100644
--- a/client-addon/EraTalents/Comms.lua
+++ b/client-addon/EraTalents/Comms.lua
@@ -66,6 +66,45 @@ function ET.ParseInspectSync(cache, message)
   return guid
 end
 
+-- Trainer books by GUID: `class[guid]` = { classId, records, partial } from BOOK (a denial has
+-- classId 0) and `riding[guid]` = { records, partial } from RIDING. A record has DragonUI's trainer
+-- shape {level, spellID, cost, previousRank, talent, raceMask, required, tree}; the server already
+-- applied the character's race, so raceMask is 0. Chunks follow the ISYNC rules.
+ET.books = ET.books or { class = {}, riding = {} }
+ET.bookHandlers = ET.bookHandlers or {}
+ET.syncHandlers = ET.syncHandlers or {}
+
+local function ParseBookChunk(store, guid, rest, entry)
+  local seq, total, tail = string.match(rest, "^(%d+)/(%d+)%s*(.*)$")
+  if seq then rest = tail end
+  if seq and tonumber(seq) > 1 then
+    entry = store[guid]
+    if not (entry and entry.partial) then return false end   -- orphan continuation: ignore
+  else
+    entry.records = {}
+    store[guid] = entry
+  end
+  entry.partial = seq ~= nil and tonumber(seq) < tonumber(total)
+  for level, spell, cost, previous, talent, required, tree in
+      string.gmatch(rest, "(%d+):(%d+):(%d+):(%d+):(%d+):(%d+):(%d+)") do
+    entry.records[#entry.records + 1] = { tonumber(level), tonumber(spell), tonumber(cost), tonumber(previous),
+                                          tonumber(talent), 0, tonumber(required), tonumber(tree) }
+  end
+  return not entry.partial
+end
+
+-- Returns the guid, "class" or "riding", and whether that book is complete; nil for other messages.
+function ET.ParseBook(books, message)
+  local guid, classId, rest = string.match(message, "^BOOK%s+(%S+)%s+(%d+)%s*(.*)$")
+  if guid then
+    return guid, "class", ParseBookChunk(books.class, guid, rest, { classId = tonumber(classId) })
+  end
+  guid, rest = string.match(message, "^RIDING%s+(%S+)%s*(.*)$")
+  if guid then return guid, "riding", ParseBookChunk(books.riding, guid, rest, {}) end
+  return nil
+end
+function ET.RequestBook(guid) ET.Send("BOOK " .. guid) end
+
 -- Generation canary. The server sends "GEN <stamp>" (from era_talent_meta) after every SYNC;
 -- the installed client patch carries the same stamp in sentinel spell 932999's NAME
 -- ("EraTalents Gen <stamp>"). A mismatch means the player's Data/patch-V.mpq is a different
@@ -114,8 +153,16 @@ function ET.OnAddonMsg(prefix, message)
     end
     return
   end
+  local bguid, kind, complete = ET.ParseBook(ET.books, message)
+  if bguid then
+    if complete then
+      for _, handler in ipairs(ET.bookHandlers) do handler(bguid, kind) end
+    end
+    return
+  end
   if ET.ParseSync(ET.state, message) then
     if ET.Refresh then ET.Refresh() end   -- TalentUI hook (may be absent in tests)
+    for _, handler in ipairs(ET.syncHandlers) do handler() end
   end
 end
 
diff --git a/client-addon/EraTalents/DragonUIBook.lua b/client-addon/EraTalents/DragonUIBook.lua
new file mode 100644
index 0000000..0a8f71a
--- /dev/null
+++ b/client-addon/EraTalents/DragonUIBook.lua
@@ -0,0 +1,106 @@
+-- DragonUI's spellbook and level-up notice list the class spells still to learn from a fixed WotLK
+-- trainer table. The server sends the character's own trainer list instead (BOOK), filtered like
+-- the trainer window by earned era, talents and class quests, and it replaces that table for the
+-- player's class. Without a reply DragonUI keeps its own table.
+--
+-- The level-up notice also lists riding, dungeons, raids and heroic modes by level. Riding levels
+-- come from the riding trainers' own list (RIDING), and instances of a later expansion than the
+-- character's earned era stay out.
+EraTalents = EraTalents or {}
+local ET = EraTalents
+
+-- Learning and talent changes arrive in bursts; one request follows the last of them.
+local BOOK_DELAY = 1
+
+local function DragonBook()
+  local dragon = _G.DragonUI
+  local book = type(dragon) == "table" and dragon.SpellbookModule
+  if type(book) ~= "table" or type(book.TrainerIndex) ~= "function" then return nil end
+  return book
+end
+
+-- The shape Book.TrainerIndex returns: the records, their next ranks by previous rank, and by spell.
+function ET.TrainerIndex(records)
+  local after, byID = {}, {}
+  for _, record in ipairs(records) do
+    byID[record[2]] = record
+    local previous = record[4]
+    if previous ~= 0 then
+      after[previous] = after[previous] or {}
+      table.insert(after[previous], record)
+    end
+  end
+  return { list = records, after = after, byID = byID }
+end
+
+local ownIndex
+
+local function OnOwnBook(guid, kind)
+  if kind ~= "class" or guid ~= UnitGUID("player") then return end
+  local entry = ET.books.class[guid]
+  if entry.classId == 0 then return end
+  ownIndex = ET.TrainerIndex(entry.records)
+  local book = DragonBook()
+  if book and type(book.MarkAllDirty) == "function" then book.MarkAllDirty() end
+end
+
+local function LevelUpRows(base, key)
+  if key == "riding" then
+    local riding = ET.books.riding[UnitGUID("player")]
+    if riding and not riding.partial then return riding.records end
+    return base.riding
+  end
+  local era = ET.state.era
+  if era == nil or era >= 2 or not (key == "dungeons" or key == "raids" or key == "heroics") then return base[key] end
+  local rows = {}
+  for _, row in ipairs(base[key] or {}) do
+    -- A heroic row names its expansion; an instance's comes from LFGDungeons, and one the client
+    -- cannot tell yet is left out rather than announced.
+    local expansion = row[2]
+    if key ~= "heroics" then expansion = select(8, GetLFGDungeonInfo(row[2])) end
+    if expansion and expansion <= era then rows[#rows + 1] = row end
+  end
+  return rows
+end
+
+local function InitLevelUp(dragon)
+  local base = dragon.LevelUpData
+  if type(base) ~= "table" or dragon._eraLevelUp then return end
+  dragon._eraLevelUp = true
+  dragon.LevelUpData = setmetatable({}, { __index = function(_, key) return LevelUpRows(base, key) end })
+end
+
+function ET.InitDragonUIBook()
+  local book = DragonBook()
+  if not book or book._eraTrainerBook then return end
+  book._eraTrainerBook = true
+  InitLevelUp(_G.DragonUI)
+
+  local trainerIndex = book.TrainerIndex
+  book.TrainerIndex = function(classToken, ...)
+    if ownIndex and classToken == select(2, UnitClass("player")) then return ownIndex end
+    return trainerIndex(classToken, ...)
+  end
+  table.insert(ET.bookHandlers, OnOwnBook)
+
+  local waited = 0
+  local timer = CreateFrame("Frame")
+  timer:Hide()
+  timer:SetScript("OnUpdate", function(self, elapsed)
+    waited = waited + elapsed
+    if waited < BOOK_DELAY then return end
+    self:Hide()
+    ET.RequestBook(UnitGUID("player"))
+  end)
+  ET.RefreshOwnBook = function()
+    waited = 0
+    timer:Show()
+  end
+
+  -- Talent ranks (SYNC), class quests and purchases change what the trainer lists.
+  local events = CreateFrame("Frame")
+  events:RegisterEvent("LEARNED_SPELL_IN_TAB")
+  events:SetScript("OnEvent", ET.RefreshOwnBook)
+  table.insert(ET.syncHandlers, ET.RefreshOwnBook)
+  ET.RefreshOwnBook()
+end
