--- /dev/null
+++ b/src/Bot/EarnedAuctionPolicy.h
@@ -0,0 +1,70 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+#ifndef PLAYERBOTS_EARNEDAUCTIONPOLICY_H
+#define PLAYERBOTS_EARNEDAUCTIONPOLICY_H
+
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+
+namespace EarnedAuction
+{
+constexpr std::uint32_t MaxListings = 20;
+constexpr std::uint32_t MaxSalesPerVisit = 2;
+constexpr std::uint32_t MaxMarketScan = 512;
+constexpr std::uint32_t MaxMailPerVisit = 20;
+constexpr std::uint32_t MaxCopper = 0x7fffffff;
+
+inline std::uint32_t UnitPriceCeiling(std::uint32_t vendorBuy, std::uint32_t vendorSell)
+{
+    // A bounded valuation keeps ordinary buyers from subsidising arbitrary asking prices.
+    std::uint64_t value = std::max<std::uint64_t>(vendorBuy, std::uint64_t(vendorSell) * 6);
+    return static_cast<std::uint32_t>(std::min<std::uint64_t>(value, MaxCopper));
+}
+
+struct ListingPrices
+{
+    std::uint32_t bid = 0;
+    std::uint32_t buyout = 0;
+};
+
+inline ListingPrices PriceListing(std::uint32_t vendorBuy, std::uint32_t vendorSell, std::uint32_t count,
+                                  std::uint32_t marketUnitPrice)
+{
+    std::uint32_t const ceiling = UnitPriceCeiling(vendorBuy, vendorSell);
+    if (!ceiling || !vendorSell || !count)
+        return {};
+    std::uint64_t const floor = std::uint64_t(vendorSell) * 2;
+    if (floor > ceiling)
+        return {};
+    std::uint64_t unit = std::min<std::uint64_t>(std::uint64_t(vendorSell) * 3, ceiling);
+    if (marketUnitPrice)
+        unit = std::clamp<std::uint64_t>(marketUnitPrice > 1 ? marketUnitPrice - 1 : 1, floor, ceiling);
+    std::uint64_t const buyout = unit * count;
+    std::uint64_t const bid = std::max<std::uint64_t>(std::uint64_t(vendorSell) * count + 1, buyout * 4 / 5);
+    if (!buyout || buyout > MaxCopper || bid > buyout)
+        return {};
+    return {static_cast<std::uint32_t>(bid), static_cast<std::uint32_t>(buyout)};
+}
+
+inline bool Affordable(std::uint32_t price, std::uint32_t budget, std::uint32_t money)
+{
+    return price && price <= MaxCopper && price <= budget && price <= money;
+}
+
+inline bool WithinPriceCeiling(std::uint32_t price, std::uint32_t count, std::uint32_t unitCeiling)
+{
+    return price && count && unitCeiling && price <= MaxCopper &&
+           std::uint64_t(price) <= std::uint64_t(count) * unitCeiling;
+}
+
+inline bool ReceiptReady(bool auctionMail, bool deleted, std::uint32_t cod, std::int64_t delivered,
+                         std::int64_t expires, std::int64_t now)
+{
+    return auctionMail && !deleted && !cod && delivered <= now && expires > now;
+}
+}  // namespace EarnedAuction
+#endif
