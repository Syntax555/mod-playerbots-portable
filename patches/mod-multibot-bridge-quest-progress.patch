+// MB_QUEST_PROGRESS_V1_BEGIN
+struct QuestProgressObjectiveData
+{
+    char type;
+    uint32 index;
+    uint32 id;
+    int64 current;
+    int64 required;
+    bool finished;
+    bool operator==(QuestProgressObjectiveData const&) const = default;
+};
+
+struct QuestProgressQuestData
+{
+    uint32 id;
+    char status;
+    std::vector<QuestProgressObjectiveData> objectives;
+    bool operator==(QuestProgressQuestData const&) const = default;
+};
+
+using QuestProgressSnapshot = std::vector<QuestProgressQuestData>;
+using QuestProgressClock = std::chrono::steady_clock;
+
+QuestProgressSnapshot BuildQuestProgressSnapshot(Player* bot)
+{
+    QuestProgressSnapshot snapshot;
+    auto const& statuses = bot->getQuestStatusMap();
+    for (uint16 slot = 0; slot < MAX_QUEST_LOG_SIZE; ++slot)
+    {
+        uint32 const questId = bot->GetQuestSlotQuestId(slot);
+        auto const found = statuses.find(questId);
+        Quest const* const quest = questId ? sObjectMgr->GetQuestTemplate(questId) : nullptr;
+        if (!quest || found == statuses.end())
+            continue;
+
+        QuestStatusData const& data = found->second;
+        if (data.Status != QUEST_STATUS_COMPLETE && data.Status != QUEST_STATUS_INCOMPLETE && data.Status != QUEST_STATUS_FAILED)
+            continue;
+
+        QuestProgressQuestData entry{questId,
+            data.Status == QUEST_STATUS_COMPLETE ? 'C' : data.Status == QUEST_STATUS_FAILED ? 'F' : 'I', {}};
+        auto append = [&entry](char type, uint32 id, int64 current, int64 required)
+        {
+            entry.objectives.push_back({type, static_cast<uint32>(entry.objectives.size() + 1), id,
+                current, required, current >= required});
+        };
+
+        // The quest template contains the credit target, including proxy kill credits.
+        // Never replace it with the last creature the bot happened to kill.
+        for (uint8 i = 0; i < QUEST_OBJECTIVES_COUNT; ++i)
+        {
+            int64 const target = quest->RequiredNpcOrGo[i];
+            if (target && quest->RequiredNpcOrGoCount[i])
+                append(target < 0 ? 'o' : 'm', static_cast<uint32>(target < 0 ? -target : target),
+                    data.CreatureOrGOCount[i], quest->RequiredNpcOrGoCount[i]);
+        }
+        for (uint8 i = 0; i < QUEST_ITEM_OBJECTIVES_COUNT; ++i)
+            if (quest->RequiredItemId[i] && quest->RequiredItemCount[i])
+                append('i', quest->RequiredItemId[i], data.ItemCount[i], quest->RequiredItemCount[i]);
+
+        if (quest->GetPlayersSlain())
+            append('p', 0, data.PlayerCount, quest->GetPlayersSlain());
+        if (quest->HasSpecialFlag(QUEST_SPECIAL_FLAGS_EXPLORATION_OR_EVENT))
+            append('e', 0, data.Explored ? 1 : 0, 1);
+        if (quest->GetRewOrReqMoney() < 0)
+            append('g', 0, bot->GetMoney(), -static_cast<int64>(quest->GetRewOrReqMoney()));
+        if (uint32 const faction = quest->GetRepObjectiveFaction())
+            append('r', faction, bot->GetReputationMgr().GetReputation(faction), quest->GetRepObjectiveValue());
+        snapshot.push_back(std::move(entry));
+    }
+    return snapshot;
+}
+
+std::vector<std::pair<std::string, std::string>> BuildQuestProgressPackets(
+    std::string const& botName, std::string const& token, ObjectGuid botGuid, QuestProgressSnapshot const& snapshot)
+{
+    std::vector<std::pair<std::string, std::string>> packets;
+    std::string const header = UrlEncodeField(botName) + kFieldSeparator + token;
+    packets.emplace_back("QUEST_PROGRESS_BEGIN", header + kFieldSeparator + botGuid.ToString());
+    for (QuestProgressQuestData const& quest : snapshot)
+    {
+        std::string const questHeader = header + kFieldSeparator + std::to_string(quest.id);
+        packets.emplace_back("QUEST_PROGRESS_QUEST", questHeader + kFieldSeparator + quest.status);
+        for (QuestProgressObjectiveData const& objective : quest.objectives)
+        {
+            std::ostringstream payload;
+            payload << questHeader << kFieldSeparator << objective.type << kFieldSeparator << objective.index
+                << kFieldSeparator << objective.id << kFieldSeparator << objective.current
+                << kFieldSeparator << objective.required << kFieldSeparator << (objective.finished ? 1 : 0);
+            packets.emplace_back("QUEST_PROGRESS_OBJECTIVE", payload.str());
+        }
+    }
+    packets.emplace_back("QUEST_PROGRESS_END", header);
+
+    // A truncated authoritative snapshot would delete valid client data.
+    for (auto const& packet : packets)
+        if (!IsAddonPacketWithinBudget(packet.first, packet.second))
+            return {};
+    return packets;
+}
+
+bool SendQuestProgressSnapshot(Player* requester, ChatMsg replyType, std::string const& botName,
+    std::string const& token, ObjectGuid botGuid, QuestProgressSnapshot const& snapshot)
+{
+    auto const packets = BuildQuestProgressPackets(botName, token, botGuid, snapshot);
+    if (packets.empty())
+    {
+        SendProtocolError(requester, replyType, "GET", "QUEST_PROGRESS", token, "PACKET_TOO_LARGE");
+        return false;
+    }
+    for (auto const& packet : packets)
+        SendAddonPacket(requester, replyType, packet.first, packet.second);
+    return true;
+}
+
+struct QuestProgressWatch
+{
+    std::string botName;
+    std::string token;
+    ChatMsg replyType;
+    QuestProgressClock::time_point expires;
+    QuestProgressSnapshot snapshot;
+};
+
+struct QuestProgressRequesterState
+{
+    QuestProgressClock::time_point windowStart;
+    QuestProgressClock::time_point lastSeen;
+    std::size_t requests = 0;
+    std::map<ObjectGuid, QuestProgressWatch> watches;
+    std::map<ObjectGuid, QuestProgressClock::time_point> lastRequests;
+};
+
+// Chat is PROCESS_THREADUNSAFE. Requests and WorldScript::OnUpdate run on the
+// world thread; OnUpdate runs after MapMgr's map-update wait barrier. Bot logout
+// hooks can run on map threads, so subscription cleanup belongs to this poll.
+std::map<ObjectGuid, QuestProgressRequesterState> questProgressRequesters;
+
+bool CanObserveQuestProgress(Player* requester, Player* bot)
+{
+    if (!requester || !bot || requester == bot || !requester->IsInWorld() || !bot->IsInWorld() ||
+        !requester->GetSession() || requester->GetSession()->IsSocketClosed() ||
+        !bot->GetSession() || !IsBotInRequesterGroup(requester, bot) ||
+        IsRealPlayer(bot) || IsSelfBot(bot))
+        return false;
+    PlayerbotAI* const ai = GetBotAI(bot);
+    return ai && ai->GetSecurity() &&
+        ai->GetSecurity()->CheckLevelFor(PLAYERBOT_SECURITY_ALLOW_ALL, true, requester);
+}
+
+void HandleQuestProgressRequest(Player* requester, ChatMsg replyType, std::string const& botName,
+    std::string const& token, std::string const& mode)
+{
+    auto const now = QuestProgressClock::now();
+    ObjectGuid const requesterGuid = requester->GetGUID();
+    auto existing = questProgressRequesters.find(requesterGuid);
+    if (existing == questProgressRequesters.end() && questProgressRequesters.size() >= 512)
+    {
+        SendProtocolError(requester, replyType, "GET", "QUEST_PROGRESS", token, "RATE_LIMIT");
+        return;
+    }
+    auto& state = questProgressRequesters[requesterGuid];
+    state.lastSeen = now;
+    if (now - state.windowStart >= std::chrono::seconds(2))
+    {
+        state.windowStart = now;
+        state.requests = 0;
+    }
+    if (++state.requests > 80)
+    {
+        SendProtocolError(requester, replyType, "GET", "QUEST_PROGRESS", token, "RATE_LIMIT");
+        return;
+    }
+
+    if (mode == "UNWATCH")
+    {
+        for (auto it = state.watches.begin(); it != state.watches.end(); ++it)
+            if (it->second.botName == botName && it->second.token == token)
+            {
+                state.watches.erase(it);
+                break;
+            }
+        return;
+    }
+
+    Player* const bot = FindBotByName(requester, botName);
+    if (!CanObserveQuestProgress(requester, bot))
+    {
+        SendProtocolError(requester, replyType, "GET", "QUEST_PROGRESS", token, "BOT_UNAVAILABLE");
+        return;
+    }
+    ObjectGuid const botGuid = bot->GetGUID();
+    auto const watch = state.watches.find(botGuid);
+    for (auto it = state.lastRequests.begin(); it != state.lastRequests.end();)
+        if (now - it->second >= std::chrono::seconds(2))
+            it = state.lastRequests.erase(it);
+        else
+            ++it;
+    auto const last = state.lastRequests.find(botGuid);
+    if (last != state.lastRequests.end() && now - last->second < std::chrono::seconds(1))
+    {
+        SendProtocolError(requester, replyType, "GET", "QUEST_PROGRESS", token, "RATE_LIMIT");
+        return;
+    }
+    if (mode == "WATCH" && watch == state.watches.end() && state.watches.size() >= 40)
+    {
+        SendProtocolError(requester, replyType, "GET", "QUEST_PROGRESS", token, "WATCH_LIMIT");
+        return;
+    }
+    state.lastRequests[botGuid] = now;
+    QuestProgressSnapshot snapshot = BuildQuestProgressSnapshot(bot);
+    if (!SendQuestProgressSnapshot(requester, replyType, bot->GetName(), token, botGuid, snapshot))
+        return;
+    if (mode == "WATCH")
+        state.watches[botGuid] = {bot->GetName(), token, replyType, now + std::chrono::seconds(180), std::move(snapshot)};
+}
+
+void UpdateQuestProgress(uint32 diff)
+{
+    static uint32 elapsed = 0;
+    elapsed += std::min(diff, uint32(1000));
+    if (elapsed < 1000)
+        return;
+    elapsed = 0;
+    auto const now = QuestProgressClock::now();
+    std::map<ObjectGuid, QuestProgressSnapshot> snapshots;
+    for (auto requesterIt = questProgressRequesters.begin(); requesterIt != questProgressRequesters.end();)
+    {
+        Player* const requester = ObjectAccessor::FindConnectedPlayer(requesterIt->first);
+        auto& state = requesterIt->second;
+        if (!requester || !requester->GetSession() || requester->GetSession()->IsSocketClosed())
+        {
+            requesterIt = questProgressRequesters.erase(requesterIt);
+            continue;
+        }
+        if (now - state.lastSeen >= std::chrono::seconds(180))
+        {
+            for (auto const& watch : state.watches)
+                SendQuestProgressSnapshot(requester, watch.second.replyType, watch.second.botName, watch.second.token, watch.first, {});
+            requesterIt = questProgressRequesters.erase(requesterIt);
+            continue;
+        }
+        if (!requester->IsInWorld())
+        {
+            ++requesterIt;
+            continue;
+        }
+        std::set<ObjectGuid> visibleBots;
+        if (!state.watches.empty())
+            for (Player* const bot : GetBridgeVisibleBots(requester))
+                visibleBots.insert(bot->GetGUID());
+        for (auto it = state.watches.begin(); it != state.watches.end();)
+        {
+            auto& watch = it->second;
+            Player* const bot = ObjectAccessor::FindPlayer(it->first);
+            // Recheck visibility as well as the group and security after control changes.
+            if (now >= watch.expires || !CanObserveQuestProgress(requester, bot) ||
+                !visibleBots.contains(it->first))
+            {
+                SendQuestProgressSnapshot(requester, watch.replyType, watch.botName, watch.token, it->first, {});
+                it = state.watches.erase(it);
+                continue;
+            }
+            auto cached = snapshots.find(it->first);
+            if (cached == snapshots.end())
+                cached = snapshots.emplace(it->first, BuildQuestProgressSnapshot(bot)).first;
+            if (watch.snapshot != cached->second &&
+                SendQuestProgressSnapshot(requester, watch.replyType, watch.botName, watch.token, it->first, cached->second))
+                watch.snapshot = cached->second;
+            ++it;
+        }
+        ++requesterIt;
+    }
+}
