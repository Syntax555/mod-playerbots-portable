+void BattlegroundWS::ConfigureEraRules(uint8 era)
+{
+    if (!GetInstanceID() || GetStatus() != STATUS_WAIT_JOIN || GetStartTime() || GetPlayersSize() || era > 2)
+        return;
+
+    _timeLimitEnabled = era >= 2;
+    _assaultDebuffsEnabled = era >= 1;
+}
