diff --git a/src/EarnedRaidComposition.cpp b/src/EarnedRaidComposition.cpp
new file mode 100644
index 0000000..dcb9aed
--- /dev/null
+++ b/src/EarnedRaidComposition.cpp
@@ -0,0 +1,212 @@
+/* GNU Affero General Public License v3.0 or later; see LICENSE. */
+#include "EarnedRaidComposition.h"
+#include "AiObjectContext.h"
+#include "CreatureData.h"
+#include "ObjectMgr.h"
+#include "Player.h"
+#include "PlayerbotAI.h"
+#include "Playerbots.h"
+#include "SpellMgr.h"
+#include <algorithm>
+#include <array>
+#include <set>
+#include <utility>
+
+namespace
+{
+    struct Profile { uint32 map; uint8 size, expansion, tanks, healers, melee; };
+    // Numerical defaults reviewed at Optimal Bot Raid 1d5476f7c782. Its class
+    // assumptions, role fallback and character-changing actions are not used.
+    constexpr Profile profiles[] = {
+        {309,20,0,3,6,3}, {509,20,0,3,5,3}, {249,40,0,3,10,4},
+        {409,40,0,5,11,8}, {469,40,0,5,13,7}, {531,40,0,5,12,7}, {533,40,0,8,12,6},
+        {532,10,1,2,3,2}, {568,10,1,2,3,2}, {565,25,1,3,7,4}, {544,25,1,3,7,5},
+        {548,25,1,4,7,4}, {550,25,1,3,7,5}, {534,25,1,3,7,5}, {564,25,1,3,7,4}, {580,25,1,3,8,4},
+        {249,10,2,2,2,1}, {249,25,2,3,5,3}, {533,10,2,2,2,2}, {533,25,2,3,5,5},
+        {615,10,2,2,2,1}, {615,25,2,2,5,5}, {616,10,2,2,2,2}, {616,25,2,2,5,5},
+        {624,10,2,2,2,2}, {624,25,2,2,5,5}, {603,10,2,2,3,1}, {603,25,2,3,6,4},
+        {649,10,2,2,2,2}, {649,25,2,3,6,4}, {631,10,2,2,3,1}, {631,25,2,2,6,5},
+        {724,10,2,2,3,1}, {724,25,2,2,6,6}
+    };
+    enum Role : uint8 { Tank, Healer, Melee, Ranged };
+    enum Benefit : uint8 { Physical = 1, Spell = 2, Mana = 4, Weapon = 8 };
+    struct Candidate
+    {
+        Player* player;
+        Role role;
+        uint8 buffs;
+        bool mana, caster;
+    };
+
+    bool PartyEffect(SpellInfo const* spell)
+    {
+        if (!spell)
+            return false;
+        for (auto const& effect : spell->Effects)
+        {
+            // An area aura's native effect determines its final recipients,
+            // even if its initial cast target is a party target.
+            if (effect.Effect == SPELL_EFFECT_APPLY_AREA_AURA_RAID)
+                continue;
+            if (effect.Effect && (effect.Effect == SPELL_EFFECT_APPLY_AREA_AURA_PARTY ||
+                effect.TargetA.GetTarget() == TARGET_UNIT_CASTER_AREA_PARTY ||
+                effect.TargetB.GetTarget() == TARGET_UNIT_CASTER_AREA_PARTY))
+                return true;
+        }
+        return false;
+    }
+
+    bool SubgroupSpell(uint32 id)
+    {
+        SpellInfo const* spell = sSpellMgr->GetSpellInfo(id);
+        if (PartyEffect(spell))
+            return true;
+        if (!spell)
+            return false;
+        for (auto const& effect : spell->Effects)
+            if (effect.Effect == SPELL_EFFECT_SUMMON && effect.MiscValue > 0)
+                if (CreatureTemplate const* totem = sObjectMgr->GetCreatureTemplate(effect.MiscValue))
+                    // Totem::InitSummon casts these two native creature spells.
+                    for (uint8 slot = 0; slot < 2; ++slot)
+                        if (PartyEffect(sSpellMgr->GetSpellInfo(totem->spells[slot])))
+                            return true;
+        return false;
+    }
+
+    uint8 GroupBuffs(Player* player)
+    {
+        PlayerbotAI* ai = GET_PLAYERBOT_AI(player);
+        auto known = [ai, player](char const* name)
+        {
+            // The ordinary AI resolver selects an active learned rank by
+            // name, including historical variants, rather than assuming a
+            // stock rank-one spell remains active after training higher ranks.
+            uint32 const spell = ai->GetAiObjectContext()->GetValue<uint32>("spell id", name)->Get();
+            return spell && player->HasActiveSpell(spell) && SubgroupSpell(spell);
+        };
+        // Scope follows the installed spell data, including historical clones.
+        // Several era totems are intentionally raid-wide and add no group score.
+        uint8 buffs = 0;
+        if (known("windfury totem") || known("strength of earth totem") || known("battle shout"))
+            buffs |= Physical;
+        if (known("grace of air totem") || known("trueshot aura"))
+            buffs |= Weapon;
+        if (known("wrath of air totem") || known("totem of wrath"))
+            buffs |= Spell;
+        if (known("mana spring totem") || known("mana tide totem"))
+            buffs |= Mana;
+        return buffs;
+    }
+
+    int GroupScore(std::vector<Candidate> const& picked, std::vector<uint8> const& groups, uint8 group)
+    {
+        uint8 buffs = 0;
+        for (size_t i = 0; i < picked.size(); ++i)
+            if (groups[i] == group)
+                buffs |= picked[i].buffs;
+        int score = 0;
+        for (size_t i = 0; i < picked.size(); ++i)
+            if (groups[i] == group)
+            {
+                Candidate const& candidate = picked[i];
+                if ((buffs & Physical) && (candidate.role == Tank || candidate.role == Melee))
+                    score += 4;
+                if ((buffs & Weapon) && (candidate.role == Tank || candidate.role == Melee ||
+                                        candidate.player->getClass() == CLASS_HUNTER))
+                    score += 4;
+                if ((buffs & Spell) && (candidate.caster || candidate.role == Healer))
+                    score += 3;
+                if ((buffs & Mana) && candidate.mana)
+                    score += 2;
+            }
+        return score;
+    }
+}
+
+namespace EarnedRaidComposition
+{
+    std::optional<Requirements> Quota(uint32 map, uint8 size, uint8 expansion)
+    {
+        for (Profile const& profile : profiles)
+            if (profile.map == map && profile.size == size && profile.expansion == expansion)
+                return Requirements{size, profile.tanks, profile.healers, profile.melee};
+        return std::nullopt;
+    }
+
+    std::vector<Member> Plan(uint32 map, uint8 size, uint8 expansion, std::vector<Player*> const& candidates)
+    {
+        std::optional<Requirements> quota = Quota(map, size, expansion);
+        if (!quota)
+            return {};
+        std::set<ObjectGuid> seen;
+        std::array<std::vector<Candidate>, 4> roles;
+        for (Player* player : candidates)
+        {
+            if (!player || !GET_PLAYERBOT_AI(player) || !seen.insert(player->GetGUID()).second)
+                return {};
+            Role const role = PlayerbotAI::IsTank(player) ? Tank : PlayerbotAI::IsHeal(player) ? Healer :
+                              PlayerbotAI::IsRanged(player) ? Ranged : Melee;
+            roles[role].push_back({player, role, GroupBuffs(player),
+                                   player->getPowerType() == POWER_MANA,
+                                   role == Ranged && player->getClass() != CLASS_HUNTER});
+        }
+        if (roles[Tank].size() < quota->tanks || roles[Healer].size() < quota->healers)
+            return {};
+        size_t const melee = std::min<size_t>(quota->melee, roles[Melee].size());
+        size_t const ranged = size - quota->tanks - quota->healers - melee;
+        if (roles[Ranged].size() < ranged)
+            return {};
+        std::vector<Candidate> picked;
+        for (auto const& [role, count] : {std::pair{Tank, size_t(quota->tanks)},
+                                        std::pair{Healer, size_t(quota->healers)},
+                                        std::pair{Melee, melee}, std::pair{Ranged, ranged}})
+            picked.insert(picked.end(), roles[role].begin(), roles[role].begin() + count);
+
+        uint8 const groupCount = size / 5;
+        std::vector<uint8> groups(size);
+        std::array<uint8, 8> occupancy{}, healers{};
+        // Reserve evenly distributed healer slots before clustering physical
+        // damage and casters; each subgroup keeps at least one healer.
+        for (size_t i = quota->tanks; i < size_t(quota->tanks + quota->healers); ++i)
+        {
+            uint8 const group = uint8(std::min_element(healers.begin(), healers.begin() + groupCount) - healers.begin());
+            groups[i] = group;
+            ++healers[group];
+            ++occupancy[group];
+        }
+        uint8 group = 0;
+        for (size_t i = 0; i < picked.size(); ++i)
+        {
+            if (picked[i].role == Healer)
+                continue;
+            while (occupancy[group] == 5)
+                ++group;
+            groups[i] = group;
+            ++occupancy[group];
+        }
+        // ponytail: local swaps find a useful layout for at most 40 members;
+        // a global optimiser is only warranted by measured gameplay needs.
+        bool improved;
+        do
+        {
+            improved = false;
+            for (size_t i = 0; i < picked.size(); ++i)
+                for (size_t j = i + 1; j < picked.size(); ++j)
+                {
+                    if (groups[i] == groups[j] || (picked[i].role == Healer) != (picked[j].role == Healer))
+                        continue;
+                    uint8 const a = groups[i], b = groups[j];
+                    int const before = GroupScore(picked, groups, a) + GroupScore(picked, groups, b);
+                    std::swap(groups[i], groups[j]);
+                    if (GroupScore(picked, groups, a) + GroupScore(picked, groups, b) > before)
+                        improved = true;
+                    else
+                        std::swap(groups[i], groups[j]);
+                }
+        } while (improved);
+        std::vector<Member> result;
+        for (size_t i = 0; i < picked.size(); ++i)
+            result.push_back({picked[i].player, groups[i]});
+        return result;
+    }
+}
diff --git a/src/EarnedRaidComposition.h b/src/EarnedRaidComposition.h
new file mode 100644
index 0000000..7220ee7
--- /dev/null
+++ b/src/EarnedRaidComposition.h
@@ -0,0 +1,20 @@
+/* GNU Affero General Public License v3.0 or later; see LICENSE. */
+#ifndef EARNED_RAID_COMPOSITION_H
+#define EARNED_RAID_COMPOSITION_H
+#include "Define.h"
+#include <optional>
+#include <vector>
+class Player;
+namespace EarnedRaidComposition
+{
+    struct Requirements { uint8 size, tanks, healers, melee; };
+    std::optional<Requirements> Quota(uint32 map, uint8 size, uint8 expansion);
+    struct Member { Player* player; uint8 subgroup; };
+    // Exact tank/healer slots and a hard melee-DPS ceiling. No role is filled
+    // by another role. The caller owns recruitment, personal access and travel.
+    // Group scores cover learned active shouts, Trueshot and utility totems
+    // with native party effects, directly or in their two totem spell slots.
+    // Raid-wide effects, passive talents and script-only buffs add no score.
+    std::vector<Member> Plan(uint32 map, uint8 size, uint8 expansion, std::vector<Player*> const& candidates);
+}
+#endif
diff --git a/src/EarnedRaidGroups.cpp b/src/EarnedRaidGroups.cpp
new file mode 100644
index 0000000..65f917b
--- /dev/null
+++ b/src/EarnedRaidGroups.cpp
@@ -0,0 +1,213 @@
+/* GNU Affero General Public License v3.0 or later; see LICENSE. */
+#include "EarnedRaidGroups.h"
+#include "EarnedRaidComposition.h"
+#include "DcEarnedRecruitment.h"
+#include "DcEarnedPlay.h"
+#include "DcEarnedProgression.h"
+#include "DcModuleEnable.h"
+#include "DBCStores.h"
+#include "Group.h"
+#include "InstanceSaveMgr.h"
+#include "ObjectMgr.h"
+#include "Player.h"
+#include "PlayerbotAI.h"
+#include "Playerbots.h"
+#include "WorldPacket.h"
+#include "WorldSession.h"
+#include <algorithm>
+#include <map>
+
+namespace
+{
+    struct SavedMember
+    {
+        Player* player;
+        std::map<std::string, bool> navigation;
+        uint8 role;
+        bool invited = false, accepted = false;
+    };
+
+    uint8 Role(Player* player)
+    {
+        return PlayerbotAI::IsTank(player) ? 0 : PlayerbotAI::IsHeal(player) ? 1 : PlayerbotAI::IsRanged(player) ? 2 : 3;
+    }
+
+    void Rollback(std::vector<SavedMember> const& saved, Player* leader, ObjectGuid groupId, uint32 continent)
+    {
+        Group* group = leader->GetGroup();
+        if (group && (group->GetGUID() != groupId || group->GetLeaderGUID() != leader->GetGUID()))
+            return;
+        if (group)
+            for (auto const& slot : group->GetMemberSlots())
+            {
+                auto const member = std::find_if(saved.begin(), saved.end(), [&](SavedMember const& value)
+                { return value.player->GetGUID() == slot.guid; });
+                // A player takeover or departure from the outdoor staging map
+                // ends our ownership. Never disband an unrelated/inside group.
+                if (member == saved.end() || !DcEarnedRecruitment::Owned(member->player, leader) ||
+                    member->player->GetMapId() != continent || member->player->IsBeingTeleported())
+                    return;
+            }
+        for (SavedMember const& member : saved)
+        {
+            Player* player = member.player;
+            if (!member.invited || !DcEarnedRecruitment::Owned(player, leader))
+                continue;
+            if (Group* invitation = player->GetGroupInvite())
+                if (invitation->GetLeaderGUID() == leader->GetGUID())
+                    player->UninviteFromGroup();
+        }
+        // Keep the leader until the native group disbands; electing a new
+        // leader would copy the old leader's instance binds to another bot.
+        for (auto member = saved.rbegin(); member != saved.rend(); ++member)
+        {
+            Player* player = member->player;
+            if (!member->invited || !DcEarnedRecruitment::Owned(player, leader))
+                continue;
+            if (player->GetGroup() && player->GetGroup()->GetGUID() != groupId)
+                continue;
+            if (member->accepted)
+                DcEarnedRecruitment::RestoreNavigation(player, member->navigation);
+            if (GET_PLAYERBOT_AI(player)->GetMaster() == leader)
+                GET_PLAYERBOT_AI(player)->SetMaster(nullptr);
+            // Removal can delete the native group; reacquire for each member.
+            if (Group* current = player->GetGroup())
+                current->RemoveMember(player->GetGUID());
+        }
+    }
+
+    bool Assign(Group* group, EarnedRaidComposition::Member const& member, uint8 size)
+    {
+        if (member.subgroup >= size / 5)
+            return false;
+        if (group->GetMemberGroup(member.player->GetGUID()) != member.subgroup)
+        {
+            // The core setter assumes capacity was checked by its caller.
+            if (std::count_if(group->GetMemberSlots().begin(), group->GetMemberSlots().end(),
+                             [&](auto const& slot) { return slot.group == member.subgroup; }) >= 5)
+                return false;
+            group->ChangeMembersGroup(member.player->GetGUID(), member.subgroup);
+        }
+        return group->GetMemberGroup(member.player->GetGUID()) == member.subgroup;
+    }
+}
+
+namespace EarnedRaidGroups
+{
+    Group* Recruit(uint32 entranceId, uint8 size, uint8 expansion, std::vector<Player*> const& online)
+    {
+        if (!DcModule::IsEnabled() || !DcEarnedPlay::Active() || !DcEarnedProgression::StrictDefault())
+            return nullptr;
+        AreaTrigger const* entrance = sObjectMgr->GetAreaTrigger(entranceId);
+        AreaTriggerTeleport const* target = sObjectMgr->GetAreaTriggerTeleport(entranceId);
+        MapEntry const* sourceMap = entrance ? sMapStore.LookupEntry(entrance->map) : nullptr;
+        MapEntry const* raid = target ? sMapStore.LookupEntry(target->target_mapId) : nullptr;
+        if (!entrance || !target || !sourceMap || !sourceMap->IsContinent() || !raid || !raid->IsRaid() ||
+            !EarnedRaidComposition::Quota(target->target_mapId, size, expansion))
+            return nullptr;
+        uint8 const level = expansion == 0 ? 60 : expansion == 1 ? 70 : 80;
+        Difficulty const difficulty = expansion == 0 && (target->target_mapId == 249 || target->target_mapId == 533) ?
+            RAID_DIFFICULTY_10MAN_HEROIC : expansion == 2 && size == 25 ? RAID_DIFFICULTY_25MAN_NORMAL : RAID_DIFFICULTY_10MAN_NORMAL;
+        MapDifficulty const* mapDifficulty = GetMapDifficultyData(target->target_mapId, difficulty);
+        if (!mapDifficulty || mapDifficulty->maxPlayers != size)
+            return nullptr;
+        auto available = [&](Player* player)
+        {
+            return DcEarnedRecruitment::Eligible(player, expansion, level, level) && !player->GetGroup() &&
+                !player->GetGroupInvite() && !player->IsInCombat() && player->GetMapId() == entrance->map &&
+                player->GetRaidDifficulty() == difficulty &&
+                DcEarnedProgression::CanEnterMap(player, target->target_mapId, target->target_X, target->target_Y,
+                                                target->target_Z) &&
+                player->Satisfy(sObjectMgr->GetAccessRequirement(target->target_mapId, difficulty),
+                                target->target_mapId, false);
+        };
+        std::vector<Player*> candidates;
+        for (Player* player : online)
+            if (available(player))
+                candidates.push_back(player);
+        for (Player* tank : candidates)
+        {
+            if (!PlayerbotAI::IsTank(tank) || tank->GetExactDist(entrance->x, entrance->y, entrance->z) > 1000.0f)
+                continue;
+            std::vector<Player*> nearby{tank};
+            for (Player* player : candidates)
+                if (player != tank && player->GetMap() == tank->GetMap() && player->GetTeamId() == tank->GetTeamId() &&
+                    (player->GetPhaseMask() & tank->GetPhaseMask()) &&
+                    player->GetExactDist(tank) <= std::min(60.0f, sPlayerbotAIConfig.SightDistance))
+                    nearby.push_back(player);
+            auto const plan = EarnedRaidComposition::Plan(target->target_mapId, size, expansion, nearby);
+            if (plan.empty())
+                continue;
+            Player* leader = plan.front().player;
+            std::vector<SavedMember> saved;
+            for (auto const& member : plan)
+            {
+                saved.push_back({member.player, {}, Role(member.player)});
+                DcEarnedRecruitment::SaveNavigation(member.player, saved.back().navigation);
+            }
+            ObjectGuid groupId;
+            auto fail = [&]() -> Group*
+            {
+                Rollback(saved, leader, groupId, entrance->map);
+                return nullptr;
+            };
+            for (size_t i = 1; i < plan.size(); ++i)
+            {
+                Player* player = plan[i].player;
+                if (!available(player) || player->GetMap() != leader->GetMap() ||
+                    player->GetTeamId() != leader->GetTeamId() || !(player->GetPhaseMask() & leader->GetPhaseMask()) ||
+                    player->GetExactDist(leader) > std::min(60.0f, sPlayerbotAIConfig.SightDistance))
+                    return fail();
+                saved[0].invited = saved[i].invited = true;
+                bool const accepted = DcEarnedRecruitment::Invite(leader, plan[i].player, "earned raid group");
+                saved[i].accepted = accepted;
+                Group* group = leader->GetGroup();
+                if (i == 1 && group)
+                    groupId = group->GetGUID();
+                if (!accepted || !group || group->GetGUID() != groupId || group->GetLeaderGUID() != leader->GetGUID() ||
+                    group->GetMembersCount() != i + 1)
+                    return fail();
+                for (size_t j = 0; j <= i; ++j)
+                    if (plan[j].player->GetGroup() != group ||
+                        !DcEarnedRecruitment::Eligible(plan[j].player, expansion, level, level, leader) ||
+                        plan[j].player->GetMap() != tank->GetMap() || Role(plan[j].player) != saved[j].role)
+                        return fail();
+                if (i == 1)
+                {
+                    WorldPacket convert;
+                    leader->GetSession()->HandleGroupRaidConvertOpcode(convert);
+                    if (!group->isRaidGroup() || !Assign(group, plan[0], size))
+                        return fail();
+                }
+                if (!group->isRaidGroup() || !Assign(group, plan[i], size))
+                    return fail();
+            }
+            Group* group = leader->GetGroup();
+            // Check every accepted bot after the native group was created;
+            // the core refuses ungrouped raid entry before checking access.
+            std::vector<Player*> members;
+            uint32 const destination = sInstanceSaveMgr->PlayerGetDestinationInstanceId(leader, target->target_mapId, difficulty);
+            for (auto const& member : plan)
+            {
+                if (!DcEarnedRecruitment::CanEnter(member.player, *target) ||
+                    !DcEarnedRecruitment::Eligible(member.player, expansion, level, level, leader) ||
+                    member.player->GetGroup() != group || Role(member.player) != saved[members.size()].role ||
+                    member.player->GetRaidDifficulty() != difficulty ||
+                    sInstanceSaveMgr->PlayerGetDestinationInstanceId(member.player, target->target_mapId, difficulty) != destination ||
+                    group->GetMemberGroup(member.player->GetGUID()) != member.subgroup)
+                    return fail();
+                members.push_back(member.player);
+            }
+            if (group->GetMembersCount() != size || !group->isRaidGroup())
+                return fail();
+            auto const currentPlan = EarnedRaidComposition::Plan(target->target_mapId, size, expansion, members);
+            if (currentPlan.size() != plan.size())
+                return fail();
+            for (size_t i = 0; i < plan.size(); ++i)
+                if (currentPlan[i].player != plan[i].player || currentPlan[i].subgroup != plan[i].subgroup)
+                    return fail();
+            return group;
+        }
+        return nullptr;
+    }
+}
