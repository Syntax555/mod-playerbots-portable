+*/
+
+#include "EarnedEraRidingPricesPolicy.h"
+#include "IndividualProgression.h"
+
+class IndividualProgressionEraRidingPrices : public PlayerScript
+{
+public:
+    IndividualProgressionEraRidingPrices()
+        : PlayerScript("IndividualProgressionEraRidingPrices", {PLAYERHOOK_ON_GET_TRAINER_SPELL_COST})
+    {
+    }
+
+    void OnPlayerGetTrainerSpellCost(Player const* player, Creature const* /*trainer*/, uint32 spellId,
+                                     uint32& moneyCost) override
+    {
+        if (!player || !player->IsInWorld())
+            return;
+
+        uint8 const era = IndividualProgression_GetEarnedEra(const_cast<Player*>(player));
+        moneyCost = EarnedEraRidingPricesPolicy::BaseCost(era, spellId, moneyCost);
+    }
+};
+
+void AddSC_individual_progression_era_riding_prices()
+{
+    new IndividualProgressionEraRidingPrices();
+}
diff --git a/src/EarnedEraRidingPricesPolicy.h b/src/EarnedEraRidingPricesPolicy.h
new file mode 100644
index 0000000..0845ac9
--- /dev/null
+++ b/src/EarnedEraRidingPricesPolicy.h
@@ -0,0 +1,35 @@
+/*
+    Copyright (C) 2016+ AzerothCore <www.azerothcore.org>, released under GNU AGPL v3 license: https://github.com/azerothcore/azerothcore-wotlk/blob/master/LICENSE-AGPL3
+*/
+
+#ifndef EARNED_ERA_RIDING_PRICES_POLICY_H
+#define EARNED_ERA_RIDING_PRICES_POLICY_H
+
+#include <cstdint>
+
+namespace EarnedEraRidingPricesPolicy
+{
+// Undiscounted copper, using late Vanilla (1.12.1), original TBC (2.4.3),
+// and the pinned Wrath trainer table. This changes costs, not availability.
+constexpr std::uint32_t BaseCost(std::uint8_t era, std::uint32_t spellId, std::uint32_t configuredCost)
+{
+    if (era > 2)
+        return configuredCost;
+
+    switch (spellId)
+    {
+        case 33388: // Apprentice Riding
+            return era == 0 ? 900000 : era == 1 ? 350000 : 40000;
+        case 33391: // Journeyman Riding
+            return era == 0 ? 9000000 : era == 1 ? 6000000 : 500000;
+        case 34090: // Expert Riding
+            return era == 0 ? configuredCost : era == 1 ? 8000000 : 2500000;
+        case 34091: // Artisan Riding
+            return era == 0 ? configuredCost : 50000000;
+        default:
+            return configuredCost;
+    }
+}
+}
+
+#endif
