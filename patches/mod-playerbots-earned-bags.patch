+bool IsGeneralBag(ItemTemplate const* proto)
+{
+    return proto->Class == ITEM_CLASS_CONTAINER && proto->SubClass == ITEM_SUBCLASS_CONTAINER;
+}
+
+// EquipAction puts a new bag into the first empty slot, else replaces the smallest
+// bag. A general bag must not displace a quiver, ammo pouch or profession bag. A
+// replacement needs a free backpack slot: a bag stored inside the bag it replaces
+// cannot be equipped from there.
+bool ReplaceableBagSize(Player* bot, uint32& size)
+{
+    Bag const* smallest = nullptr;
+    for (uint8 slot = INVENTORY_SLOT_BAG_START; slot < INVENTORY_SLOT_BAG_END; ++slot)
+    {
+        Bag const* bag = bot->GetBagByPos(slot);
+        if (!bag)
+        {
+            size = 0;
+            return true;
+        }
+        if (!smallest || bag->GetBagSize() <= smallest->GetBagSize())
+            smallest = bag;
+    }
+    size = smallest->GetBagSize();
+    if (!IsGeneralBag(smallest->GetTemplate()))
+        return false;
+    for (uint8 slot = INVENTORY_SLOT_ITEM_START; slot < INVENTORY_SLOT_ITEM_END; ++slot)
+        if (!bot->GetItemByPos(INVENTORY_SLOT_BAG_0, slot))
+            return true;
+    return false;
+}
+
+// A carried bag upgrade is equipped by the ordinary upgrade action, or cannot be,
+// for example from inside the bag it would replace. Either way, buy no other.
+bool CarriesBagUpgrade(PlayerbotAI* botAI, uint32 replaceable)
+{
+    Player* bot = botAI->GetBot();
+    auto const upgrade = [&](Item const* item)
+    {
+        ItemTemplate const* proto = item ? item->GetTemplate() : nullptr;
+        return proto && IsGeneralBag(proto) && proto->ContainerSlots > replaceable &&
+               botAI->GetAiObjectContext()->GetValue<ItemUsage>("item upgrade", proto->ItemId)->Get() ==
+                   ITEM_USAGE_EQUIP;
+    };
+    for (uint8 slot = INVENTORY_SLOT_ITEM_START; slot < INVENTORY_SLOT_ITEM_END; ++slot)
+        if (upgrade(bot->GetItemByPos(INVENTORY_SLOT_BAG_0, slot)))
+            return true;
+    for (uint8 slot = INVENTORY_SLOT_BAG_START; slot < INVENTORY_SLOT_BAG_END; ++slot)
+        if (Bag const* bag = bot->GetBagByPos(slot))
+            for (uint32 position = 0; position < bag->GetBagSize(); ++position)
+                if (upgrade(bag->GetItemByPos(position)))
+                    return true;
+    return false;
+}
+}  // namespace
+
+bool BagPurchaseUseful(PlayerbotAI* botAI, ItemTemplate const* proto)
+{
+    uint32 replaceable = 0;
+    return IsGeneralBag(proto) && ReplaceableBagSize(botAI->GetBot(), replaceable) &&
+           !CarriesBagUpgrade(botAI, replaceable);
+}
