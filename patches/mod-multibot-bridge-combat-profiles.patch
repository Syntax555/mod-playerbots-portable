+Player* FindCombatProfileTarget(Player* requester, std::string const& name, std::string& reason)
+{
+    if (!requester || !requester->GetSession())
+    {
+        reason = "BAD_REQUEST";
+        return nullptr;
+    }
+    Player* bot = name == requester->GetName() ? requester : FindBotByName(requester, name);
+    PlayerbotAI* ai = GetBotAI(bot);
+    if (!bot)
+        reason = "NO_BOT";
+    else if (!bot->IsInWorld() || !bot->GetSession())
+        reason = "BOT_UNAVAILABLE";
+    else if (!ai)
+        reason = "NO_AI";
+    else if (!ai->GetSecurity() ||
+             !ai->GetSecurity()->CheckLevelFor(PLAYERBOT_SECURITY_ALLOW_ALL, true, requester))
+        reason = "FORBIDDEN";
+    else
+        return bot;
+    return nullptr;
+}
+
+void SendCombatProfileResult(Player* requester, ChatMsg replyType, std::string const& token,
+                             std::string const& name, Player* bot, std::string const& reason, bool listRequest = false)
+{
+    std::ostringstream payload;
+    payload << token << kFieldSeparator << UrlEncodeField(name)
+        << kFieldSeparator << (reason == "OK" ? "OK" : "ERR")
+        << kFieldSeparator << reason
+        << kFieldSeparator << (bot ? AiFactory::GetCombatProfile(bot) : "auto")
+        << kFieldSeparator << (bot ? AiFactory::GetEffectiveCombatProfile(bot) : "");
+    if (!IsAddonPacketWithinBudget("COMBAT_PROFILE_RESULT", payload.str()))
+    {
+        SendProtocolError(requester, replyType, listRequest ? "GET" : "RUN",
+                          listRequest ? "COMBAT_PROFILES" : "COMBAT_PROFILE", token, "TOO_LARGE");
+        return;
+    }
+    SendAddonPacket(requester, replyType, "COMBAT_PROFILE_RESULT", payload.str());
+}
+
+void SendCombatProfiles(Player* requester, ChatMsg replyType, std::string const& name,
+                        std::string const& token)
+{
+    std::string reason = "OK";
+    Player* bot = FindCombatProfileTarget(requester, name, reason);
+    if (bot && !ConsumeStrategyMutationRateLimit(requester))
+        reason = "RATE_LIMIT";
+    if (reason != "OK")
+    {
+        SendCombatProfileResult(requester, replyType, token, name, bot, reason, true);
+        return;
+    }
+    std::ostringstream payload;
+    payload << token << kFieldSeparator << UrlEncodeField(bot->GetName())
+        << kFieldSeparator << AiFactory::GetCombatProfile(bot)
+        << kFieldSeparator << AiFactory::GetEffectiveCombatProfile(bot) << kFieldSeparator;
+    bool first = true;
+    for (std::string const& profile : AiFactory::GetCombatProfiles(bot->getClass()))
+    {
+        if (!first)
+            payload << ',';
+        payload << profile;
+        first = false;
+    }
+    if (!IsAddonPacketWithinBudget("COMBAT_PROFILES", payload.str()))
+    {
+        SendProtocolError(requester, replyType, "GET", "COMBAT_PROFILES", token, "TOO_LARGE");
+        return;
+    }
+    SendAddonPacket(requester, replyType, "COMBAT_PROFILES", payload.str());
+}
+
+void RunCombatProfileCommand(Player* requester, ChatMsg replyType, std::string const& name,
+                             std::string const& token, std::string const& profile)
+{
+    std::string reason = "OK";
+    Player* bot = FindCombatProfileTarget(requester, name, reason);
+    if (bot)
+    {
+        if (!ConsumeStrategyMutationRateLimit(requester))
+            reason = "RATE_LIMIT";
+        else if (bot->IsBeingTeleported())
+            reason = "BOT_UNAVAILABLE";
+        else if (bot->IsInCombat())
+            reason = "IN_COMBAT";
+        else if (!bot->IsAlive())
+            reason = "DEAD";
+        else if (!AiFactory::SetCombatProfile(bot, profile))
+            reason = "BAD_PROFILE";
+    }
+    SendCombatProfileResult(requester, replyType, token, name, bot, reason);
+}
