+    {
+        ::SaveNavigation(player, saved);
+    }
+
+    void RestoreNavigation(Player* player, std::map<std::string, bool> const& saved)
+    {
+        for (auto const& [name, had] : saved)
+            GET_PLAYERBOT_AI(player)->ChangeStrategy(std::string(had ? "+" : "-") + name, BOT_STATE_NON_COMBAT);
+    }
+}
