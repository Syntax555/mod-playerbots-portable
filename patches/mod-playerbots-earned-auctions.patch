diff --git a/src/Bot/EarnedAuctionPolicy.h b/src/Bot/EarnedAuctionPolicy.h
new file mode 100644
index 0000000..59ac112
--- /dev/null
+++ b/src/Bot/EarnedAuctionPolicy.h
@@ -0,0 +1,162 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+#ifndef PLAYERBOTS_EARNEDAUCTIONPOLICY_H
+#define PLAYERBOTS_EARNEDAUCTIONPOLICY_H
+
+#include <algorithm>
+#include <array>
+#include <charconv>
+#include <cstdint>
+#include <limits>
+#include <optional>
+#include <string_view>
+#include <system_error>
+#include <tuple>
+
+namespace EarnedAuction
+{
+constexpr std::uint32_t MaxListings = 20;
+constexpr std::uint32_t MaxSalesPerVisit = 2;
+constexpr std::uint32_t MaxSameItemListings = 2;
+constexpr std::uint32_t MaxMarketScan = 512;
+constexpr std::uint32_t MaxMailPerVisit = 20;
+constexpr std::uint32_t MaxCopper = 0x7fffffff;
+// Stock that expires unsold this often is vendored instead of paying more deposits.
+constexpr std::uint32_t MaxUnsoldListings = 2;
+constexpr std::int64_t UnsoldMemorySeconds = 7 * 24 * 3600;
+
+// A bounded valuation of count items keeps ordinary buyers from subsidising
+// arbitrary asking prices: the vendor's price per item, as vendors sell BuyCount
+// items for BuyPrice, or six times the vendor sell price, whichever is higher.
+inline std::uint32_t PriceCeiling(std::uint32_t vendorBuy, std::uint32_t buyCount, std::uint32_t vendorSell,
+                                  std::uint32_t count)
+{
+    std::uint64_t const bundle = std::max<std::uint32_t>(buyCount, 1);
+    std::uint64_t const vendor = (std::uint64_t(vendorBuy) * count + bundle - 1) / bundle;
+    std::uint64_t const resale = std::min<std::uint64_t>(std::uint64_t(vendorSell) * 6, MaxCopper) * count;
+    return static_cast<std::uint32_t>(std::min<std::uint64_t>(std::max(vendor, resale), MaxCopper));
+}
+
+struct ListingPrices
+{
+    std::uint32_t bid = 0;
+    std::uint32_t buyout = 0;
+};
+
+inline ListingPrices PriceListing(std::uint32_t vendorBuy, std::uint32_t buyCount, std::uint32_t vendorSell,
+                                  std::uint32_t count, std::uint32_t marketUnitPrice)
+{
+    if (!vendorSell || !count)
+        return {};
+    // Undercut the cheapest comparable offer. A market at twice the vendor price or
+    // below leaves no room, and a listing above it would not sell first.
+    std::uint64_t const floor = std::min<std::uint64_t>(std::uint64_t(vendorSell) * 2, MaxCopper) * count;
+    std::uint64_t const unit = marketUnitPrice ? marketUnitPrice - 1 : std::uint64_t(vendorSell) * 3;
+    std::uint64_t const buyout = std::min<std::uint64_t>(std::min<std::uint64_t>(unit, MaxCopper) * count,
+                                                         PriceCeiling(vendorBuy, buyCount, vendorSell, count));
+    std::uint64_t const bid = std::max<std::uint64_t>(std::uint64_t(vendorSell) * count + 1, buyout * 4 / 5);
+    if (!buyout || buyout < floor || buyout > MaxCopper || bid > buyout)
+        return {};
+    return {static_cast<std::uint32_t>(bid), static_cast<std::uint32_t>(buyout)};
+}
+
+// A sale, after the house cut, must beat vendoring the stack by at least the
+// deposit, which an expired listing loses.
+inline bool WorthListing(std::uint32_t buyout, std::uint32_t cut, std::uint64_t vendorValue, std::uint32_t deposit)
+{
+    return buyout > cut && std::uint64_t(buyout - cut) >= vendorValue + std::max<std::uint32_t>(deposit, 1);
+}
+
+inline bool Affordable(std::uint32_t price, std::uint32_t budget, std::uint32_t money)
+{
+    return price && price <= MaxCopper && price <= budget && price <= money;
+}
+
+inline bool WithinPriceCeiling(std::uint32_t price, std::uint32_t ceiling) { return price && price <= ceiling; }
+
+// One purchase per visit goes to the most useful tier: gear upgrades, ammunition,
+// consumables, then gathering tools. Within a tier the offer cheapest against its
+// valuation wins, so a cheap item does not beat a bargain upgrade.
+struct OfferRank
+{
+    std::uint32_t tier = 0;
+    std::uint64_t relative = 0;
+    std::uint32_t price = 0;
+};
+
+inline OfferRank RankOffer(std::uint32_t tier, std::uint32_t price, std::uint32_t ceiling)
+{
+    return {tier, ceiling ? std::uint64_t(price) * 1000 / ceiling : UINT64_MAX, price};
+}
+
+inline bool BetterOffer(OfferRank offer, OfferRank best)
+{
+    return std::tie(offer.tier, offer.relative, offer.price) < std::tie(best.tier, best.relative, best.price);
+}
+
+struct AuctionSubject
+{
+    std::uint32_t item = 0;
+    std::uint32_t response = 0;
+    std::uint32_t auction = 0;
+    std::uint32_t count = 0;
+};
+
+// Reads the core's auction mail subject, "item:0:response:auction:count".
+inline std::optional<AuctionSubject> ParseAuctionSubject(std::string_view subject)
+{
+    std::array<std::uint32_t, 5> fields{};
+    for (std::size_t index = 0; index < fields.size(); ++index)
+    {
+        bool const final = index + 1 == fields.size();
+        std::size_t const end = final ? subject.size() : subject.find(':');
+        if (!end || end == std::string_view::npos)
+            return {};
+        char const* const last = subject.data() + end;
+        auto const [parsed, error] = std::from_chars(subject.data(), last, fields[index]);
+        if (error != std::errc() || parsed != last)
+            return {};
+        subject.remove_prefix(final ? end : end + 1);
+    }
+    if (fields[1])
+        return {};
+    return AuctionSubject{fields[0], fields[2], fields[3], fields[4]};
+}
+
+struct UnsoldRecord
+{
+    std::uint32_t unsold = 0;
+    std::int64_t last = 0;
+};
+
+// The memory outlasts the listing rounds it compares, however long they run.
+inline bool UnsoldForgotten(UnsoldRecord record, std::int64_t now, std::int64_t listing)
+{
+    return now - record.last >= std::max<std::int64_t>(UnsoldMemorySeconds, 3 * listing);
+}
+
+inline bool RelistAllowed(UnsoldRecord record, std::int64_t now, std::int64_t listing)
+{
+    return record.unsold < MaxUnsoldListings || UnsoldForgotten(record, now, listing);
+}
+
+// Stacks listed in one round return within a listing duration of its first expiry
+// and count once. A refusal, with no round, always counts.
+inline void CountUnsold(UnsoldRecord& record, std::int64_t now, std::int64_t round)
+{
+    if (record.unsold && now - record.last < round)
+        return;
+    ++record.unsold;
+    record.last = now;
+}
+
+inline bool ReceiptReady(bool auctionMail, bool deleted, std::uint32_t cod, std::int64_t delivered,
+                         std::int64_t expires, std::int64_t now)
+{
+    return auctionMail && !deleted && !cod && delivered <= now && expires > now;
+}
+}  // namespace EarnedAuction
+#endif
diff --git a/src/Bot/EarnedAuctionTravel.cpp b/src/Bot/EarnedAuctionTravel.cpp
new file mode 100644
index 0000000..ff699e7
--- /dev/null
+++ b/src/Bot/EarnedAuctionTravel.cpp
@@ -0,0 +1,196 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+
+#include "EarnedAuctionTravel.h"
+
+#include <algorithm>
+#include <atomic>
+#include <memory>
+#include <unordered_map>
+#include <vector>
+
+#include "AiObjectContext.h"
+#include "AuctionHouseMgr.h"
+#include "BudgetValues.h"
+#include "Creature.h"
+#include "DBCStores.h"
+#include "EarnedAuction.h"
+#include "EarnedAuctionTravelPolicy.h"
+#include "Map.h"
+#include "ObjectMgr.h"
+#include "Player.h"
+#include "PlayerbotAI.h"
+#include "Timer.h"
+#include "World.h"
+
+namespace EarnedAuctionTravel
+{
+namespace
+{
+using MarketCache = std::unordered_map<uint32, std::vector<MarketSite>>;
+std::atomic<std::shared_ptr<MarketCache const>> marketCache;
+
+uint32 PurchaseSavings(PlayerbotAI* ai)
+{
+    AiObjectContext* context = ai->GetAiObjectContext();
+    uint32 const gear = context->GetValue<uint32>("free money for", uint32(NeedMoneyFor::gear))->Get();
+    uint32 const supplies = context->GetValue<uint32>("money needed for", uint32(NeedMoneyFor::consumables))->Get();
+    uint32 const consumables = context->GetValue<uint32>("free money for", uint32(NeedMoneyFor::consumables))->Get();
+    return std::min(std::max(gear > supplies ? gear - supplies : 0, consumables), ai->GetBot()->GetMoney() / 4);
+}
+
+bool FriendlyMarket(Player* bot, MarketSite const& market)
+{
+    FactionTemplateEntry const* faction = sFactionTemplateStore.LookupEntry(market.factionTemplateId);
+    return faction && bot->GetFactionReactionTo(faction, bot) >= REP_NEUTRAL;
+}
+}  // namespace
+
+void LoadMarkets()
+{
+    auto cache = std::make_shared<MarketCache>();
+    for (auto const& [spawnId, data] : sObjectMgr->GetAllCreatureData())
+    {
+        CreatureTemplate const* creature = sObjectMgr->GetCreatureTemplate(data.id);
+        MapEntry const* map = sMapStore.LookupEntry(data.mapid);
+        if (!creature || !map || map->IsDungeon() || !data.spawnMask)
+            continue;
+        uint32 npcFlags = 0;
+        uint32 unitFlags = 0;
+        uint32 dynamicFlags = 0;
+        ObjectMgr::ChooseCreatureFlags(creature, npcFlags, unitFlags, dynamicFlags, &data);
+        if (!(npcFlags & UNIT_NPC_FLAG_AUCTIONEER))
+            continue;
+        AuctionHouseEntry const* house = AuctionHouseMgr::GetAuctionHouseEntryFromFactionTemplate(creature->faction);
+        if (!house)
+            continue;
+        (*cache)[data.mapid].push_back({data.mapid, data.phaseMask, house->houseId, creature->faction, data.posX,
+                                        data.posY, data.posZ, data.orientation});
+    }
+    // Publish immutable spawn metadata; never inspect the world's spawn store from a bot map thread.
+    marketCache.store(std::move(cache), std::memory_order_release);
+}
+
+bool Ready(PlayerbotAI* ai)
+{
+    if (!EarnedAuction::IsEnabled(ai))
+        return false;
+    Player* bot = ai->GetBot();
+    return bot->GetLevel() >= MinimumLevel && bot->IsInWorld() && bot->IsAlive() && !bot->GetGroup() &&
+           !bot->IsInCombat() && !bot->IsInFlight() && !bot->IsBeingTeleported() && !bot->InBattleground() &&
+           !bot->GetTradeData() && bot->GetMap() && !bot->GetMap()->IsDungeon() && ai->CanMove() &&
+           ai->GetAiObjectContext()->GetValue<bool>("can move around")->Get();
+}
+
+bool CompatibleAuctioneer(PlayerbotAI* ai, Creature* auctioneer)
+{
+    if (!ai || !ai->GetBot() || !EarnedAuction::MeetsAuctionLevel(ai->GetBot()) || !auctioneer ||
+        !auctioneer->IsAlive() || !auctioneer->HasNpcFlag(UNIT_NPC_FLAG_AUCTIONEER) ||
+        auctioneer->IsHostileTo(ai->GetBot()))
+        return false;
+    AuctionHouseEntry const* botHouse =
+        AuctionHouseMgr::GetAuctionHouseEntryFromFactionTemplate(ai->GetBot()->GetFaction());
+    AuctionHouseEntry const* marketHouse =
+        AuctionHouseMgr::GetAuctionHouseEntryFromFactionTemplate(auctioneer->GetFaction());
+    return botHouse && marketHouse && CompatibleHouse(botHouse->houseId, marketHouse->houseId);
+}
+
+void FinishTrip(PlayerbotAI* ai)
+{
+    if (!ai || !ai->rpgInfo.earnedAuctionTravelActive)
+        return;
+    auto& info = ai->rpgInfo;
+    info.earnedAuctionTravelActive = false;
+    info.earnedAuctionTravelLastAttempt = getMSTime();
+    info.earnedAuctionTravelClockStarted = true;
+    info.earnedAuctionTravelDestination = {};
+}
+
+bool ContinueTrip(PlayerbotAI* ai)
+{
+    if (!ai || !ai->rpgInfo.earnedAuctionTravelActive)
+        return false;
+    auto& info = ai->rpgInfo;
+    if (!Ready(ai) || info.earnedAuctionTravelDestination.GetMapId() != ai->GetBot()->GetMapId() ||
+        TravelDeadlineReached(GetMSTimeDiffToNow(info.earnedAuctionTravelStarted)))
+    {
+        AbortTrip(ai);
+        return false;
+    }
+    return true;
+}
+
+void AbortTrip(PlayerbotAI* ai)
+{
+    if (ai && ai->rpgInfo.earnedAuctionTravelActive)
+        PostponeVisit(ai);
+}
+
+void PostponeVisit(PlayerbotAI* ai)
+{
+    if (!ai)
+        return;
+    FinishTrip(ai);
+    ai->rpgInfo.earnedAuctionLastVisit = getMSTime();
+    ai->rpgInfo.earnedAuctionVisitDelay = TravelBackoffMs;
+}
+
+// An unreachable mailbox or auctioneer would otherwise be chosen for every visit
+// while it stays nearest. Skip it for a while, so another can serve.
+void RejectVisit(PlayerbotAI* ai, ObjectGuid target)
+{
+    if (!ai)
+        return;
+    PostponeVisit(ai);
+    ai->rpgInfo.earnedAuctionRejected = target;
+    ai->rpgInfo.earnedAuctionRejectedAt = getMSTime();
+}
+
+ObjectGuid RejectedTarget(PlayerbotAI* ai)
+{
+    auto const& info = ai->rpgInfo;
+    return RejectionActive(GetMSTimeDiffToNow(info.earnedAuctionRejectedAt)) ? info.earnedAuctionRejected
+                                                                             : ObjectGuid::Empty;
+}
+
+WorldPosition PlanTrip(PlayerbotAI* ai)
+{
+    if (ContinueTrip(ai))
+        return ai->rpgInfo.earnedAuctionTravelDestination;
+    if (!Ready(ai))
+        return {};
+    auto& info = ai->rpgInfo;
+    if (info.earnedAuctionTravelClockStarted &&
+        !TravelBackoffElapsed(GetMSTimeDiffToNow(info.earnedAuctionTravelLastAttempt)))
+        return {};
+    info.earnedAuctionTravelClockStarted = true;
+    info.earnedAuctionTravelLastAttempt = getMSTime();
+    Player* bot = ai->GetBot();
+    if (!CanStartTravel(bot->GetLevel(), sWorld->getIntConfig(CONFIG_AUCTION_LEVEL_REQ), EarnedAuction::HasSurplus(ai),
+                        PurchaseSavings(ai)))
+        return {};
+    auto const cache = marketCache.load(std::memory_order_acquire);
+    if (!cache)
+        return {};
+    auto const markets = cache->find(bot->GetMapId());
+    if (markets == cache->end())
+        return {};
+    AuctionHouseEntry const* botHouse = AuctionHouseMgr::GetAuctionHouseEntryFromFactionTemplate(bot->GetFaction());
+    if (!botHouse)
+        return {};
+    MarketOrigin const origin{bot->GetMapId(),     bot->GetPhaseMask(), botHouse->houseId,
+                              bot->GetPositionX(), bot->GetPositionY(), bot->GetPositionZ()};
+    auto const nearest = NearestMarketIndex(markets->second, origin,
+                                            [bot](MarketSite const& site) { return FriendlyMarket(bot, site); });
+    if (!nearest)
+        return {};
+    MarketSite const& market = markets->second[*nearest];
+    info.earnedAuctionTravelDestination = WorldPosition(market.mapId, market.x, market.y, market.z, market.orientation);
+    info.earnedAuctionTravelStarted = getMSTime();
+    info.earnedAuctionTravelActive = true;
+    return info.earnedAuctionTravelDestination;
+}
+}  // namespace EarnedAuctionTravel
