+
+    // Use a strict three-dimensional center distance, without combat-reach
+    // radii, and the core's same-map/instance and same-phase checks.
+    return killed->IsWithinDistInMap(rewardPosition, sWorld->getFloatConfig(CONFIG_GROUP_XP_DISTANCE), true, false,
