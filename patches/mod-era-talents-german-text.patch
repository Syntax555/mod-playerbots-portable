+    { id=20734, tab=2, tier=4, col=1, name="Demonic Sacrifice", icon="spell_shadow_psychicscream", maxRank=1, prereqTalent=0, prereqPoints=20, wired=true, tooltip={ "When activated, sacrifices your summoned demon to grant you an effect that lasts 30 min. The effect is canceled if any Demon is summoned. Imp: Increases your Fire damage by 15%. Voidwalker: Restores 2% of total health every 4 sec. Succubus: Increases your Shadow damage by 15%. Felhunter: Restores 3% of total mana every 4 sec. Felguard: Increases your Shadow damage by 10% and restores 2% of total mana every 4 sec." }, grant={ [1]=948552 }, localized={deDE={name="Dämonische Opferung", tooltip={ "Opfert bei Aktivierung Euren beschworenen Dämon und gewährt Euch einen Effekt, der 30 Min. lang anhält. Der Effekt endet, sobald ein Dämon beschworen wird. Wichtel: Erhöht Euren Feuerschaden um 15%. Leerwandler: Stellt alle 4 Sek. 2% Eurer gesamten Gesundheit wieder her. Sukkubus: Erhöht Euren Schattenschaden um 15%. Teufelsjäger: Stellt alle 4 Sek. 3% Eures gesamten Manas wieder her. Teufelswache: Erhöht Euren Schattenschaden um 10% und stellt alle 4 Sek. 2% Eures gesamten Manas wieder her." }}} },
